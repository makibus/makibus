<?xml version="1.0" encoding="UTF-8"?>
<!-- filename: org.freedesktop.IBus.xpc.plist -->
<!-- Install to ~/Library/LaunchAgents and load with:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.freedesktop.IBus.xpc.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.freedesktop.IBus.xpc</string>
	<key>ProgramArguments</key>
	<array>
		<string>@libexecdir@/ibus-xpc-bridge</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.freedesktop.IBus.xpc</key>
		<true/>
	</dict>
	<!-- The bridge runs at load and is kept alive, like the
	     ibus-daemon, since the on-demand launch with the first XPC
	     connection is not always triggered by launchd.
	<key>KeepAlive</key>
	<false/>
	-->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
